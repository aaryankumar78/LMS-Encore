<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="com.smartlms.model.User" %>
<%
  User currentUser = (User) session.getAttribute("user");
  String ctx = request.getContextPath();
%>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= request.getAttribute("pageTitle") == null ? "Smart LMS" : request.getAttribute("pageTitle") %> | Smart LMS</title>
<link rel="stylesheet" href="<%=ctx%>/css/style.css">
</head>
<body>
<div class="app-shell">
<aside class="sidebar">
  <a class="brand" href="<%=ctx%>/dashboard"><span class="brand-mark">S</span><span>Smart<span class="brand-light">LMS</span><small>LEARN WITH PURPOSE</small></span></a>
  <div class="nav-label">WORKSPACE</div>
  <a class="nav-link" href="<%=ctx%>/dashboard"><span>▦</span> Overview</a>
  <a class="nav-link" href="<%=ctx%>/courses"><span>▤</span> Courses</a>
  <a class="nav-link" href="<%=ctx%>/assignments"><span>✓</span> Assignments</a>
  <div class="sidebar-note"><div class="note-icon">✦</div><strong>Small steps count.</strong><p>Keep learning. Your progress adds up.</p></div>
  <div class="sidebar-bottom"><div class="avatar"><%= currentUser == null ? "S" : currentUser.getFullName().substring(0,1).toUpperCase() %></div>
    <div class="profile-text"><strong><%= currentUser == null ? "Guest" : currentUser.getFullName() %></strong><small><%= currentUser == null ? "" : currentUser.getRole().equals("ADMIN") ? "Administrator" : "Student" %></small></div>
    <form action="<%=ctx%>/logout" method="post"><button class="icon-button" title="Sign out" aria-label="Sign out">↗</button></form>
  </div>
</aside>
<main class="main-area">
<header class="topbar"><div><div class="eyebrow">YOUR LEARNING SPACE</div><div class="topbar-title"><%= currentUser == null ? "Welcome" : "Hi, " + currentUser.getFullName().split(" ")[0] + "!" %></div></div>
<div class="topbar-right"><span class="status-dot"></span><span>Workspace ready</span><span class="top-avatar"><%= currentUser == null ? "S" : currentUser.getFullName().substring(0,1).toUpperCase() %></span></div></header>
<div class="page-content">
